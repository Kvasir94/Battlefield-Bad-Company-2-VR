{
  "schema": "fvr.bc2.replay_scenario.v1",
  "name": "xm8-mag-reload",
  "mechanism": "detachable magazine: pull, pouch, insert, seat",
  "weapon": "XM8_sp_s",
  "capacity": 30,
  "tape": "../tapes/xm8-mag-reload.fvrtape",
  "sim": {"supported": true, "loaded": 27, "reserve": 83, "capacity": 30},
  "live": {"trace_switches": ["-MagazineReload"], "seconds": 45},
  "analyzer_rules": {"min_reloads": 1, "max_seat_credit_ms": 1000},
  "rules": [
    {"id": "fvr_order", "type": "sequence",
     "steps": ["begin", "unseat", "pouch_start", "capture", "seat", "transfer[copy=server]", "credit", "complete", "end"]},
    {"id": "native_order", "type": "sequence",
     "steps": ["firing_state[copy=server,to=10]", "firing_state[copy=server,to=11]", "freeze_start[copy=server]",
               "freeze_stop[copy=server]", "firing_state[copy=server,to=12]", "transfer[copy=server]",
               "firing_state[copy=server,to=2]"]},
    {"id": "one_seat", "type": "count", "match": "seat", "eq": 1},
    {"id": "one_transfer", "type": "count", "match": "transfer[copy=server]", "eq": 1},
    {"id": "one_credit", "type": "count", "match": "credit", "eq": 1},
    {"id": "no_cancel", "type": "count", "match": "cancel", "eq": 0},
    {"id": "ammo_fill", "type": "ammo_delta", "copy": "server", "loaded": "+fill", "reserve": "-fill", "conserve": true},
    {"id": "seat_to_transfer", "type": "within", "from": "seat", "to": "transfer[copy=server]", "max_ms": 1500},
    {"id": "seat_to_credit", "type": "within", "from": "seat", "to": "credit", "max_ms": 1000},
    {"id": "no_native_reload_without_seat", "label": "headset 2026-10-05: native reload continued without insertion",
     "type": "never", "match": "transfer", "before": "seat"},
    {"id": "no_transfer_state_without_seat", "type": "never", "match": "firing_state[to=12]", "before": "seat"},
    {"id": "no_auto_reload", "type": "never", "match": "auto_reload[suppressed=false]"},
    {"id": "no_fire_mag_out", "type": "never", "match": "fire[result=shot]", "while": "mag_out"},
    {"id": "no_drops", "type": "never", "match": "dropped"}
  ]
}

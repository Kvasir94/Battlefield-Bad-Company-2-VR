{
  "schema": "fvr.bc2.replay_scenario.v1",
  "name": "xm8-fire-reload",
  "mechanism": "one launch, three verdicts: fire the magazine empty, dry pulls on the empty gun, then the AS2 slider magazine reload (pull, pouch, insert past 25%, let go, settle seats, credit)",
  "weapon": "XM8_sp_s",
  "capacity": 30,
  "tape": "../tapes/xm8-slider-release.fvrtape",
  "sim": {"supported": false},
  "live": {"trace_switches": ["-MagazineSliderReleaseProbe"], "seconds": 30},
  "analyzer_rules": {"min_reloads": 1},
  "rules": [
    {"id": "fire_shot", "label": "fire: at least one round leaves the server copy", "type": "count", "match": "fire[copy=server,result=shot]", "min": 1},
    {"id": "fire_states", "label": "fire: 2 -> 9 -> 2 on the server copy", "type": "sequence",
     "steps": ["firing_state[copy=server,from=2,to=9]", "firing_state[copy=server,from=9,to=2]"]},
    {"id": "fire_client0", "label": "fire: the shot also lands on client copy A", "type": "count", "match": "fire[copy=client0,result=shot]", "min": 1},
    {"id": "fire_client1", "label": "fire: the shot also lands on client copy B", "type": "count", "match": "fire[copy=client1,result=shot]", "min": 1},
    {"id": "dry_server", "label": "dry fire: 3 pulls on the empty gun, per copy", "type": "count", "match": "fire[copy=server,result=dry]", "min": 3},
    {"id": "dry_client0", "type": "count", "match": "fire[copy=client0,result=dry]", "min": 3},
    {"id": "dry_client1", "type": "count", "match": "fire[copy=client1,result=dry]", "min": 3},
    {"id": "dry_no_click", "label": "dry fire: no native click (VR plays it)", "type": "never", "match": "fire[result=dry,native_click=true]"},
    {"id": "dry_no_transfer", "label": "dry fire: pulls do not start a reload", "type": "never", "match": "transfer", "before": "begin"},
    {"id": "fire_before_reload", "type": "never", "match": "begin", "before": "fire[copy=server,result=shot]"},
    {"id": "fvr_order", "type": "sequence",
     "steps": ["begin", "unseat", "pouch_start", "release[to=well]", "seat", "transfer[copy=server]", "credit", "complete", "end"]},
    {"id": "native_order", "label": "reload: 11, 12 + transfer, back to 2 (10 may commit inside the same Update)", "type": "sequence",
     "steps": ["firing_state[copy=server,to=11]", "firing_state[copy=server,to=12]", "transfer[copy=server]", "firing_state[copy=server,to=2]"]},
    {"id": "one_settle", "type": "count", "match": "release[to=well]", "eq": 1},
    {"id": "one_seat", "type": "count", "match": "seat", "eq": 1},
    {"id": "one_transfer", "type": "count", "match": "transfer[copy=server]", "eq": 1},
    {"id": "one_credit", "type": "count", "match": "credit", "eq": 1},
    {"id": "no_cancel", "type": "count", "match": "cancel", "eq": 0},
    {"id": "settle_to_seat", "label": "AS2 maxMagAutoInsertTime 250 ms plus one gather", "type": "within",
     "from": "release[to=well]", "to": "seat", "max_ms": 300},
    {"id": "seat_to_transfer", "type": "within", "from": "seat", "to": "transfer[copy=server]", "max_ms": 1500},
    {"id": "seat_to_credit", "type": "within", "from": "seat", "to": "credit", "max_ms": 1000},
    {"id": "no_native_reload_without_seat", "type": "never", "match": "transfer", "before": "seat"},
    {"id": "no_auto_reload", "type": "never", "match": "auto_reload[suppressed=false]"},
    {"id": "no_fire_mag_out", "type": "never", "match": "fire[result=shot]", "while": "mag_out"},
    {"id": "no_drops", "type": "never", "match": "dropped"}
  ]
}
